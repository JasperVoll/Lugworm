<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net7.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RootNamespace>Lugworm.Core</RootNamespace>
    <!-- Ships beside Lugworm.gha: keep equal to <Version> in Lugworm/Lugworm.csproj.
         tools/release.ps1 and tests/tooling/test_version_sync.py refuse a mismatch. -->
    <Version>0.1.1-beta</Version>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <!-- Release binaries must not embed local paths (PDB path in the PE debug
       directory) - map the project directory to a neutral prefix. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildProjectDirectory)=/Lugworm.Core</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exact-source deterministic rebuild of the Clipper2 1.4.0 package
         (AUD-REL-002): the NuGet binary embeds the upstream author's local PDB
         path. Same sources, same strong name - see third_party/Clipper2/PROVENANCE.md. -->
    <ProjectReference Include="..\third_party\Clipper2\Clipper2Lib\Clipper2Lib.csproj" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- ZipArchive for the dependency-free xlsx writer/reader (Doe/) -->
    <Reference Include="System.IO.Compression" />
    <!-- HttpClient for the Duet/RRF WiFi client (Duet/) -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
