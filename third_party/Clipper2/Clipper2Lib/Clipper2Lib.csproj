<Project Sdk="Microsoft.NET.Sdk">

  <!-- Exact-source rebuild of the Clipper2 1.4.0 NuGet package (AUD-REL-002).
       Sources, strong-name key and license are verbatim from upstream tag
       Clipper2_1.4.0 (commit 736ddb0b53d97fd5f65dd3d9bbf8a0993eaf387c) - see
       ../PROVENANCE.md. This csproj replaces upstream's only to build
       deterministically without the upstream author's local PDB path in the
       CodeView record; assembly name, version, target framework, language
       version and strong-name identity are unchanged. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>8</LangVersion>
    <AssemblyName>Clipper2Lib</AssemblyName>
    <RootNamespace>Clipper2Lib</RootNamespace>
    <Version>1.4.0</Version>
    <Authors>Angus Johnson</Authors>
    <Description>Polygon Clipping and Offsetting Library</Description>
    <Copyright>Copyright © 2010-2023</Copyright>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Clipper2.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PathMap>$(MSBuildProjectDirectory)=/Clipper2Lib</PathMap>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

</Project>
